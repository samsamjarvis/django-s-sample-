# ============ Django ============
SECRET_KEY=change-me-generate-64-random-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,silver.example.com
CSRF_TRUSTED_ORIGINS=https://silver.example.com

# ============ Admin (hideable) ============
ADMIN_URL=admin/
ADMIN_LOGIN_ENABLED=True

# ============ Database (PostgreSQL) ============
DB_NAME=silver_db
DB_USER=silver_user
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# ============ Redis ============
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

# ============ Fernet (field-level DB encryption) ============
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
FIELD_ENCRYPTION_ENABLED=True

# ============ CORS / CSRF (prod) ============
CORS_ALLOWED_ORIGINS=https://silver.example.com
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True

# ============ Zarinpal (Phase 7) ============
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=True
ZARINPAL_CALLBACK_URL=https://silver.example.com/payment/verify/

# ============ SMS.ir (Phase 7) ============
SMSIR_API_KEY=
SMSIR_LINE_NUMBER=
SMSIR_TEMPLATE_OTP=100000
SMSIR_TEMPLATE_ORDER=100001

# ============ 2FA (Phase 6) ============
TWO_FACTOR_ENABLED=True

# ============ Email ============
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@silver.example.com
EMAIL_HOST_PASSWORD=change-me
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Silver <noreply@silver.example.com>

# ============ Sentry ============
SENTRY_DSN=

# ============ Paths ============
LOG_LEVEL=INFO

# ============ Site ============
SITE_NAME=Silver
SITE_DOMAIN=silver.example.com
SITE_PROTOCOL=https